@page "/produtos"
@rendermode InteractiveServer
@using LojaBlazor.Models

<PageTitle>Produtos</PageTitle>

<div class="container mt-4">
    <h2>Produtos</h2>
    <p class="text-muted">Cadastro de produtos</p>

    <div class="card p-3 shadow-sm mb-4">
        <!-- EditForm so chama SalvarProduto se passar nas regras do ProdutoModel -->
        <EditForm Model="produto" OnValidSubmit="SalvarProduto">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Nome:</label>
                <InputText @bind-Value="produto.Nome" class="form-control" placeholder="Nome do produto" />
                <ValidationMessage For="() => produto.Nome" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label">Preço:</label>
                <InputNumber @bind-Value="produto.Preco" class="form-control"
                             ParsingErrorMessage="O preço deve ser um número." />
                <ValidationMessage For="() => produto.Preco" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">Cadastrar</button>
        </EditForm>
    </div>

    @if (produtos.Count == 0)
    {
        <div class="alert alert-info">Nenhum produto cadastrado ainda.</div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Preço</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in produtos)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Nome</td>
                    <td>@p.Preco.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@code {
    private ProdutoModel produto = new();
    private List<ProdutoModel> produtos = new();
    private int proximoId = 1;

    // so chega aqui se o formulario estiver valido
    private void SalvarProduto()
    {
        produto.Id = proximoId++;
        produtos.Add(produto);

        // novo objeto = formulario volta vazio
        produto = new ProdutoModel();
    }
}
